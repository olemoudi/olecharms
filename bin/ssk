#!/usr/bin/env bash
# ssk — SSH keys and git identities, per command or folder (ssk help)
#
# Identities are named key pairs (~/.ssh/<name>.privatekey / .pubkey, as
# `switchsshkey add` always stored them) plus optional details in
# ~/.config/olecharms/identities/<name>: email, name, gh (GitHub CLI user).
#
#   ssk add <name> <private_key> <public_key> [--email E] [--name N] [--gh USER]
#   ssk set <name> email|name|gh <value>       ("" clears it)
#   ssk run <name> -- <command...>             that command only: this key
#                                              (IdentitiesOnly), author, GH_TOKEN
#   ssk bind <name> [folder]                   git inside that folder always uses
#                                              the identity (includeIf in ~/.gitconfig)
#   ssk unbind [folder]
#   ssk which [folder]                         what git will use there
#   ssk test <name> [host]                     ask GitHub (or host) who the key is
#   ssk list [--plain]                         identities and their folders
#   ssk                                        the pair copied to ~/.ssh/id_ed25519
#   ssk <name>                                 old style: copy that pair over
#                                              ~/.ssh/id_ed25519 (affects every
#                                              terminal and agent — prefer run/bind)
# Bash 3.2 compatible (macOS).

set -u
SSH_DIR="$HOME/.ssh"
ID_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/olecharms/identities"
ACTIVE="$SSH_DIR/id_ed25519"

die()  { echo "ssk: $*" >&2; exit 1; }
note() { echo "ssk: $*" >&2; }

# The olecharms checkout this script lives in (through the ~/.local/bin link)
repo_dir() {
    local self=$0 dir
    while [ -L "$self" ]; do
        dir=$(cd "$(dirname "$self")" && pwd) || return 1
        self=$(readlink "$self")
        case "$self" in /*) ;; *) self=$dir/$self ;; esac
    done
    (cd "$(dirname "$self")/.." && pwd)
}

# Keep the agents' instructions in step with the identities (quietly)
refresh_agents() {
    local r
    r=$(repo_dir) || return 0
    [ -f "$r/olecharms.sh" ] && bash "$r/olecharms.sh" agents refresh --quiet >/dev/null 2>&1
    return 0
}

valid_name() {
    case "$1" in
        ""|*/*|.*|-*|*[!A-Za-z0-9._-]*|help|list|add|set|run|bind|unbind|bindings|which|test|current) return 1 ;;
    esac
    return 0
}

key_of() { echo "$SSH_DIR/$1.privatekey"; }
pub_of() { echo "$SSH_DIR/$1.pubkey"; }
exists() { [ -f "$(key_of "$1")" ] && [ -f "$(pub_of "$1")" ]; }
need()   { valid_name "$1" && exists "$1" || die "no identity '$1' (ssk list shows them)"; }

# Detail $2 of identity $1 (email, name, gh)
get() {
    [ -f "$ID_DIR/$1" ] || return 0
    sed -n "s/^$2=//p" "$ID_DIR/$1" | tail -n 1
}

put() {
    local name="$1" field="$2" value="$3" f tmp
    case "$field" in email|name|gh) ;; *) die "unknown detail '$field' (email, name or gh)" ;; esac
    case "$value" in *$'\n'*) die "the value must be one line" ;; esac
    mkdir -p "$ID_DIR" || die "cannot create $ID_DIR"
    f="$ID_DIR/$name"
    tmp=$(mktemp "$ID_DIR/.tmp.XXXXXX") || die "mktemp failed"
    { [ -f "$f" ] && grep -v "^$field=" "$f"; [ -n "$value" ] && printf '%s=%s\n' "$field" "$value"; } > "$tmp"
    mv "$tmp" "$f"
}

# The ssh command line for identity $1, quoted for a shell (git runs
# core.sshCommand and GIT_SSH_COMMAND through one)
ssh_cmd() {
    local k
    k=$(key_of "$1")
    printf "ssh -i '%s' -o IdentitiesOnly=yes" "$(printf '%s' "$k" | sed "s/'/'\\\\''/g")"
}

# The git config file generated for identity $1 (bindings include it)
gitconfig_of() { echo "$ID_DIR/$1.gitconfig"; }

write_gitconfig() {
    local name="$1" f email uname
    f=$(gitconfig_of "$name")
    mkdir -p "$ID_DIR" || return 1
    : > "$f.tmp" || return 1
    git config --file "$f.tmp" core.sshCommand "$(ssh_cmd "$name")"
    email=$(get "$name" email); uname=$(get "$name" name)
    [ -n "$email" ] && git config --file "$f.tmp" user.email "$email"
    [ -n "$uname" ] && git config --file "$f.tmp" user.name "$uname"
    { echo "# ssk identity '$name' — generated by ssk; change it with: ssk set $name ..."; cat "$f.tmp"; } > "$f"
    rm -f "$f.tmp"
}

# Bindings: "folder<TAB>identity" per line, from ~/.gitconfig includeIf entries
# that point at our generated files. -z: the folder may contain spaces (git
# then ends the key with a newline and the entry with a NUL)
bindings() {
    local entry key value nl='
'
    git config --global -z --get-regexp '^includeif\.gitdir:.*\.path$' 2>/dev/null |
    while IFS= read -r -d '' entry; do
        key=${entry%%"$nl"*}
        value=${entry#*"$nl"}
        case "$value" in "$ID_DIR"/*.gitconfig) ;; *) continue ;; esac
        key=${key#includeif.gitdir:}
        key=${key%.path}
        value=${value##*/}
        printf '%s\t%s\n' "${key%/}" "${value%.gitconfig}"
    done
}

# Absolute, symlink-free folder $1 (default: here)
real_dir() {
    local d="${1:-$PWD}"
    [ -d "$d" ] || die "no such folder: $d"
    (cd -P "$d" && pwd)
}

tilde() { case "$1" in "$HOME"|"$HOME"/*) echo "~${1#"$HOME"}" ;; *) echo "$1" ;; esac; }

cmd_current() {
    local f
    [ -f "$ACTIVE.pub" ] || die "no active key ($ACTIVE.pub not found)"
    for f in "$SSH_DIR"/*.pubkey; do
        [ -f "$f" ] || continue
        if cmp -s "$ACTIVE.pub" "$f"; then
            basename "$f" .pubkey
            return 0
        fi
    done
    note "unknown (no named key matches $ACTIVE.pub)"
    return 1
}

cmd_list() {
    local plain="${1:-}" f name email gh dirs
    for f in "$SSH_DIR"/*.pubkey; do
        [ -f "$f" ] || continue
        name=$(basename "$f" .pubkey)
        valid_name "$name" || continue
        email=$(get "$name" email); gh=$(get "$name" gh)
        dirs=$(bindings | awk -F '\t' -v n="$name" '$2 == n { print $1 }' | while IFS= read -r d; do tilde "$d"; done | paste -sd, - | sed 's/,/, /g')
        if [ "$plain" = --plain ]; then
            printf '%s\t%s\t%s\t%s\n' "$name" "$email" "$gh" "$dirs"
        else
            printf '%-12s %s%s%s\n' "$name" "${email:-(no email)}" "${gh:+  github: $gh}" "${dirs:+  folders: $dirs}"
        fi
    done
}

cmd_add() {
    [ $# -ge 3 ] || die "usage: ssk add <name> <private_key> <public_key> [--email E] [--name N] [--gh USER]"
    local name="$1" priv="$2" pub="$3" a b
    shift 3
    valid_name "$name" || die "invalid identity name: '$name'"
    [ -r "$priv" ] || die "cannot read private key file: $priv"
    [ -r "$pub" ] || die "cannot read public key file: $pub"
    a=$(head -n 1 "$priv"); b=$(head -n 1 "$pub")
    case "$a" in ssh-*|ecdsa-*) die "the private and public key arguments look swapped" ;; esac
    case "$b" in -----BEGIN*) die "the private and public key arguments look swapped" ;; esac
    exists "$name" && die "identity '$name' already exists"
    [ -e "$(key_of "$name")" ] || [ -e "$(pub_of "$name")" ] && die "$(key_of "$name") or its .pubkey already exists"
    mkdir -p "$SSH_DIR" && chmod 700 "$SSH_DIR" 2>/dev/null
    (umask 077; cp "$priv" "$(key_of "$name")") || die "copy failed"
    cp "$pub" "$(pub_of "$name")" || die "copy failed"
    chmod 600 "$(key_of "$name")"; chmod 644 "$(pub_of "$name")"
    while [ $# -gt 0 ]; do
        case "$1" in
            --email) put "$name" email "${2:-}"; shift 2 ;;
            --name)  put "$name" name "${2:-}"; shift 2 ;;
            --gh)    put "$name" gh "${2:-}"; shift 2 ;;
            *) die "unknown option: $1" ;;
        esac
    done
    echo "ssk: added identity '$name'"
    refresh_agents
}

cmd_set() {
    [ $# -eq 3 ] || die "usage: ssk set <name> email|name|gh <value>"
    need "$1"
    put "$1" "$2" "$3"
    # Folders bound to it pick the change up through the generated file
    [ -f "$(gitconfig_of "$1")" ] && write_gitconfig "$1"
    echo "ssk: $1: $2 ${3:+= $3}${3:-cleared}"
    refresh_agents
}

cmd_run() {
    [ $# -ge 1 ] || die "usage: ssk run <name> -- <command...>"
    local name="$1" email uname gh token
    shift
    [ "${1:-}" = -- ] && shift
    [ $# -gt 0 ] || die "usage: ssk run <name> -- <command...>"
    need "$name"
    export GIT_SSH_COMMAND
    GIT_SSH_COMMAND=$(ssh_cmd "$name")
    email=$(get "$name" email); uname=$(get "$name" name); gh=$(get "$name" gh)
    [ -n "$email" ] && export GIT_AUTHOR_EMAIL="$email" GIT_COMMITTER_EMAIL="$email"
    [ -n "$uname" ] && export GIT_AUTHOR_NAME="$uname" GIT_COMMITTER_NAME="$uname"
    if [ -n "$gh" ] && command -v gh >/dev/null 2>&1; then
        if token=$(gh auth token --hostname github.com --user "$gh" 2>/dev/null) && [ -n "$token" ]; then
            export GH_TOKEN="$token"
        else
            note "gh has no login for '$gh' (gh auth login); running without GH_TOKEN"
        fi
    fi
    exec "$@"
}

cmd_bind() {
    [ $# -ge 1 ] || die "usage: ssk bind <name> [folder]"
    local name="$1" dir f
    need "$name"
    dir=$(real_dir "${2:-}") || exit 1
    [ "$dir" != / ] && [ "$dir" != "$HOME" ] || die "bind a project folder, not $(tilde "$dir") (it would cover every repository)"
    write_gitconfig "$name" || die "could not write $(gitconfig_of "$name")"
    f=$(gitconfig_of "$name")
    # One identity per folder: drop an earlier binding of this folder
    unbind_dir "$dir" >/dev/null
    git config --global --add "includeIf.gitdir:$dir/.path" "$f" || die "could not update ~/.gitconfig"
    echo "ssk: git inside $(tilde "$dir") now uses '$name'"
    refresh_agents
}

# Remove the binding of real folder $1 (only entries pointing at our files)
unbind_dir() {
    local dir="$1" key value n=0
    while IFS="$(printf '\t')" read -r key value; do
        [ "$key" = "$dir" ] || continue
        git config --global --unset-all "includeIf.gitdir:$dir/.path" \
            "^$(printf '%s' "$(gitconfig_of "$value")" | sed 's/[][\.*^$+?(){}|]/\\&/g')\$" && n=$((n + 1))
    done <<< "$(bindings)"
    [ "$n" -gt 0 ]
}

cmd_unbind() {
    local dir="${1:-$PWD}"
    if [ -d "$dir" ]; then
        dir=$(real_dir "$dir") || exit 1
    else
        # A bound folder that was deleted: its full path, as ssk list shows it
        case "$dir" in "~"/*) dir="$HOME/${dir#"~/"}" ;; /*) ;; *) die "give the full path of the deleted folder" ;; esac
        dir=${dir%/}
    fi
    if unbind_dir "$dir"; then
        echo "ssk: $(tilde "$dir") no longer bound"
        refresh_agents
    else
        die "$(tilde "$dir") is not bound (ssk list shows the bindings)"
    fi
}

cmd_which() {
    local dir origin email cmd name
    dir=$(real_dir "${1:-}") || exit 1
    if ! git -C "$dir" rev-parse --git-dir >/dev/null 2>&1; then
        name=$(bindings | awk -F '\t' -v d="$dir" 'index(d "/", $1 "/") == 1 { print $2 }' | tail -n 1)
        echo "$(tilde "$dir") is not a git repository; bindings apply inside repositories${name:+ (repositories here would use '$name')}"
        return 0
    fi
    origin=$(git -C "$dir" config --show-origin --get core.sshCommand 2>/dev/null)
    email=$(git -C "$dir" config --get user.email 2>/dev/null)
    local tab=$'\t'
    cmd=${origin#*"$tab"}
    origin=${origin%%"$tab"*}
    case "$origin" in
        "file:$ID_DIR"/*.gitconfig) name=${origin##*/}; name=${name%.gitconfig} ;;
        *) name="" ;;
    esac
    if [ -n "$name" ]; then
        echo "identity: $name (bound folder)"
    elif [ -n "${GIT_SSH_COMMAND:-}" ]; then
        echo "identity: set for this command by GIT_SSH_COMMAND"
    elif [ -n "$cmd" ]; then
        echo "identity: core.sshCommand from ${origin#file:}"
    else
        echo "identity: none bound — ssh's default keys$([ -f "$ACTIVE.pub" ] && printf ' (%s: %s)' "$(tilde "$ACTIVE")" "$(cmd_current 2>/dev/null || echo unnamed)")"
    fi
    echo "email:    ${email:-(not set)}"
    git -C "$dir" remote -v 2>/dev/null | awk '$3 == "(push)" { print "push to: " $1 " " $2 }'
}

cmd_test() {
    [ $# -ge 1 ] || die "usage: ssk test <name> [host]"
    local name="$1" host="${2:-github.com}" out who
    need "$name"
    out=$(ssh -T -i "$(key_of "$name")" -o IdentitiesOnly=yes -o BatchMode=yes \
              -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new "git@$host" 2>&1 </dev/null)
    who=$(printf '%s\n' "$out" | sed -n 's/^Hi \([^!]*\)!.*/\1/p' | head -n 1)
    if [ -n "$who" ]; then
        echo "ssk: $host knows this key as: $who"
        return 0
    fi
    printf '%s\n' "$out" | tail -n 3 >&2
    die "$host did not accept '$name'"
}

# Old style: copy the named pair over ~/.ssh/id_ed25519
cmd_switch() {
    local name="$1" f saved="" backup newfp
    need "$name"
    if [ -f "$ACTIVE" ]; then
        for f in "$SSH_DIR"/*.pubkey; do
            [ -f "$f" ] || continue
            if cmp -s "$ACTIVE" "${f%.pubkey}.privatekey"; then saved=1; break; fi
        done
        if [ -z "$saved" ]; then
            backup="backup-$(date +%Y%m%d-%H%M%S)"
            (umask 077; cp -p "$ACTIVE" "$SSH_DIR/$backup.privatekey") || exit 1
            chmod 600 "$SSH_DIR/$backup.privatekey"
            [ -f "$ACTIVE.pub" ] && cp -p "$ACTIVE.pub" "$SSH_DIR/$backup.pubkey"
            note "the active key was not saved under a name; kept it as '$backup'"
        fi
    fi
    (umask 077; cp "$(key_of "$name")" "$ACTIVE") || exit 1
    cp "$(pub_of "$name")" "$ACTIVE.pub" || exit 1
    chmod 600 "$ACTIVE"; chmod 644 "$ACTIVE.pub"
    echo "ssk: switched to '$name' (for every terminal and agent; 'ssk run' or 'ssk bind' change nothing global)"
    # A running ssh-agent offers its keys before ~/.ssh/id_ed25519: GitHub
    # would then accept whichever account it knows first
    if command -v ssh-add >/dev/null 2>&1 && command -v ssh-keygen >/dev/null 2>&1; then
        newfp=$(ssh-keygen -lf "$ACTIVE.pub" 2>/dev/null | awk '{ print $2 }')
        if ssh-add -l 2>/dev/null | awk -v fp="$newfp" '$2 != fp { found = 1 } END { exit !found }'; then
            note "ssh-agent still holds other keys and offers them first; 'ssh-add -D' forgets them"
        fi
    fi
}

usage() { sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; }

case "${1:-}" in
    "")            cmd_current ;;
    current)       cmd_current ;;
    -h|--help|help) usage ;;
    list)          shift; cmd_list "$@" ;;
    add)           shift; cmd_add "$@" ;;
    set)           shift; cmd_set "$@" ;;
    run)           shift; cmd_run "$@" ;;
    bind)          shift; cmd_bind "$@" ;;
    unbind)        shift; cmd_unbind "$@" ;;
    bindings)      bindings ;;   # folder<TAB>identity per line, for scripts
    which)         shift; cmd_which "$@" ;;
    test)          shift; cmd_test "$@" ;;
    *)             [ $# -eq 1 ] || die "unknown command: $1 (ssk help)"; cmd_switch "$1" ;;
esac

#!/usr/bin/env bash
# trash — move files to the trash, recoverably (--list, --restore)
# The work is done by `olecharms trash`, which shares the cleanup's backends
# and its refusals of protected folders.
self=$0
while [ -L "$self" ]; do
    dir=$(cd "$(dirname "$self")" && pwd) || exit 1
    self=$(readlink "$self")
    case "$self" in /*) ;; *) self=$dir/$self ;; esac
done
exec bash "$(cd "$(dirname "$self")/.." && pwd)/olecharms.sh" trash "$@"
